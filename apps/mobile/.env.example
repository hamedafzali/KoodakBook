# Backend origin, reachable FROM THE DEVICE — never "localhost" (that would be
# the phone itself). API paths already start with /api, so no path suffix here.
#
#   Local backend (Mac dev):   http://<your-mac-lan-ip>:4000
#   Home server deploy:        http://192.168.178.37
EXPO_PUBLIC_API_URL=http://192.168.178.37
