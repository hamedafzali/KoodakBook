{
  "expo": {
    "name": "کودک‌ بوک",
    "slug": "koodakbook",
    "version": "0.1.0",
    "scheme": "koodakbook",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "extra": {
      "supportsRTL": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koodakbook.app"
    },
    "android": {
      "package": "com.koodakbook.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
