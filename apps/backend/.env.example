PORT=4000
ADMIN_EMAIL=admin@koodakbook.com
ADMIN_PASSWORD=changeme
DATABASE_URL=postgres://user:password@localhost:5432/koodakbook
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d
WEB_URL=http://localhost:3000
UPLOADS_DIR=./uploads
# Child voice recordings (mig 061). MUST NOT be inside UPLOADS_DIR: that
# directory is served publicly by express.static and by nginx in prod.
READ_ALOUD_DIR=./private/read-aloud
# Days a recording lives before the sweeper deletes it, unless a parent
# pressed "keep". Lowering this shortens retention for existing rows too.
READ_ALOUD_TTL_DAYS=30

# Weekly parent digest (optional). Without RESEND_API_KEY the digest dry-runs to logs.
# RESEND_API_KEY=re_...
# DIGEST_FROM=KoodakBook <digest@yourdomain.com>   # from-domain must be verified in Resend

# Public Telegram channel announcements (optional). Without TELEGRAM_BOT_TOKEN
# these dry-run to logs. Bot must be added to the channel as admin with post
# permission — see docs/telegram-channel.md for the @BotFather setup steps.
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_CHANNEL=@koodakbook_app

# Private admin DMs — new signups, leads/contact submissions (optional).
# Without ADMIN_TELEGRAM_BOT_TOKEN these dry-run to logs. A separate bot/token
# from TELEGRAM_BOT_TOKEN and ALERT_TELEGRAM_BOT_TOKEN — see docs/admin-notify.md
# for the @BotFather setup steps and how to find your chat ID.
# ADMIN_TELEGRAM_BOT_TOKEN=123456:AA...
# ADMIN_TELEGRAM_CHAT_ID=123456789
