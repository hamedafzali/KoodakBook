PORT=4000
ADMIN_EMAIL=admin@koodakbook.com
ADMIN_PASSWORD=changeme
DATABASE_URL=postgres://user:password@localhost:5432/koodakbook
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d
WEB_URL=http://localhost:3000
UPLOADS_DIR=./uploads

# Weekly parent digest (optional). Without RESEND_API_KEY the digest dry-runs to logs.
# RESEND_API_KEY=re_...
# DIGEST_FROM=KoodakBook <digest@yourdomain.com>   # from-domain must be verified in Resend

# Public Telegram channel announcements (optional). Without TELEGRAM_BOT_TOKEN
# these dry-run to logs. Bot must be added to the channel as admin with post
# permission — see docs/telegram-channel.md for the @BotFather setup steps.
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_CHANNEL=@koodakbook_app
