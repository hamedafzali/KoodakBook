# Production secrets — copy to .env and fill in real values
DB_PASSWORD=changeme
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
WEB_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com
# Public site origin — used for the sitemap, robots.txt, and OG/canonical URLs
# (apps/web/src/app/{sitemap,robots,layout}.tsx). NEXT_PUBLIC_* vars are inlined
# at `next build` time, so this must reach docker-compose.yml's web.build.args,
# not just the container's runtime environment. Without it these fall back to
# http://localhost:3000 in the built output — wrong sitemap/canonical URLs.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=changeme
# Optional — enables AI-personalized story generation. Leave blank to disable.
# One key for whichever provider is selected in the admin panel (Anthropic /
# OpenAI / DeepSeek / Kimi / Qwen / …).
AI_API_KEY=

# ── Alerting (Phase 0) ────────────────────────────────────────────────────────
# Shared dead-man's-switch + active-alert transport. Leave blank to DRY-RUN
# (every signal is logged, nothing is sent). See docs/alerting.md for setup.
#
# healthchecks.io project ping key. This alone enables real pinging. The email
# and Telegram CHANNELS are attached to each check in the healthchecks.io
# dashboard — that is what pages you on a *missed* heartbeat.
HEALTHCHECKS_PING_KEY=
# Optional direct-to-Telegram path for *active* alerts (lower latency, and works
# even if healthchecks.io is down). Leave blank to rely on the hc.io Telegram
# integration instead. If set, BOTH are required.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ── Phase 1B: encrypted offsite backups (db-backup sidecar) ───────────────────
# All real values live in ACM project variables — these are placeholders only.
# The sidecar DRY-RUNs (logs, no external calls) while the S3/heartbeat vars are
# blank, so the image is safe to run before the R2 + healthchecks accounts exist.
TZ=Europe/Berlin
# Least-privilege DB role — apply docker/db-backup/backup-role.sql, then set this.
BACKUP_DB_PASSWORD=
# Cloudflare R2 bucket (object-lock ON; account SEPARATE from the age-key store).
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_BUCKET=koodakbook-backups
BACKUP_PREFIX=koodakbook
BACKUP_KEY_ID=            # R2 token: write + list only (NO delete)
BACKUP_KEY_SECRET=
RESTORE_KEY_ID=          # R2 token: read only (used by the restore-drill)
RESTORE_KEY_SECRET=
# age encryption. PUBLIC key (recipient) only — safe on the server. The PRIVATE
# key never touches the server: password-manager + physical copy off-site.
AGE_RECIPIENT=age1...
# Private key for the AUTOMATED weekly drill only. Leave blank to rely on the
# quarterly MANUAL drill's off-server key (AGE_IDENTITY_FILE mount) instead.
AGE_IDENTITY=
# healthchecks.io check URLs — absence of a ping is the alert (dead-man's switch).
HEARTBEAT_BACKUP_URL=
HEARTBEAT_DRILL_URL=
# Password for the throwaway db-drill restore-target server.
DRILL_PGPASSWORD=
